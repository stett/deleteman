<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line driver for the deletion engine, used by scripts\bench.ps1. Published with Native AOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DeleteMan.Bench</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseRidGraph>false</UseRidGraph>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050;IL2075</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeleteMan.Engine\DeleteMan.Engine.csproj" />
  </ItemGroup>

</Project>
