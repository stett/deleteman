<?xml version="1.0" encoding="utf-8"?>
<!--
  Default style and template of SegmentButton. Layer order (back to front): background (colour, hatch or drive
  track) → used fill → progress overlay / indeterminate stripes → right-edge separator → label (with a 1 px drop
  shadow) → hover/pressed wash → expanded ring.

  Only the parts every segment shows live here. The hatch, the drive fill, the progress overlay and stripes and the
  expanded ring are created by SegmentButton the first time a segment needs them and
  inserted at their place in this order: a plain folder segment is then 8 elements instead of 30, and a row of
  64 segments lays out in a fraction of the time. Brushes that depend on Appearance are set in code
  (SegmentButton.UpdateVisuals) because the hatch brushes are built there.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeleteMan.App.Controls">

  <Style TargetType="local:SegmentButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <!-- Draw the focus ring inside the segment: neighbours touch, so an outside ring would be half hidden. -->
    <Setter Property="FocusVisualMargin" Value="0" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SegmentButton">
          <Grid x:Name="RootGrid" Background="Transparent">
            <Grid x:Name="ContentGrid">
              <Rectangle x:Name="BackgroundRect" />
              <Rectangle x:Name="Separator" Width="1" HorizontalAlignment="Right"
                         Fill="{ThemeResource SegmentSeparatorBrush}" />
              <TextBlock x:Name="TextShadow"
                         Margin="7,1,0,0" VerticalAlignment="Center"
                         FontSize="12" TextWrapping="NoWrap" TextTrimming="None"
                         Foreground="{ThemeResource SegmentTextShadowBrush}"
                         IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="TextPart"
                         Margin="6,0,0,0" VerticalAlignment="Center"
                         FontSize="12" TextWrapping="NoWrap" TextTrimming="None"
                         IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
              <Rectangle x:Name="HoverOverlay" Opacity="0" Fill="{ThemeResource SegmentHoverBrush}" />
              <Rectangle x:Name="PressedOverlay" Opacity="0" Fill="{ThemeResource SegmentPressedBrush}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverOverlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverOverlay.Opacity" Value="1" />
                    <Setter Target="PressedOverlay.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <!-- No own dimming: segments are disabled only while a deletion locks the UI, and then the whole
                     row is dimmed by its owner. -->
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
