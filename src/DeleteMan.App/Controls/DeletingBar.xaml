<?xml version="1.0" encoding="utf-8"?>
<!-- The bar of a row being deleted: dark red track, red fill of the done fraction (or sliding stripes when the
     total is unknown), and the progress text over it. -->
<UserControl
    x:Class="DeleteMan.App.Controls.DeletingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeleteMan.App.Controls"
    IsTabStop="False">

  <Grid x:Name="RootGrid" Background="{ThemeResource ProgressTrackBrush}" SizeChanged="OnSizeChanged">
    <Rectangle x:Name="FillRect" HorizontalAlignment="Left" Width="0" Fill="{ThemeResource ProgressFillBrush}" />
    <local:StripeFill x:Name="Stripes"
                      ColorAKey="ProgressStripeAColor" ColorBKey="ProgressStripeBColor"
                      IsAnimated="True" Visibility="Collapsed" />
    <TextBlock x:Name="TextShadow" Margin="9,1,8,0" VerticalAlignment="Center"
               Text="{x:Bind Text, Mode=OneWay}" TextWrapping="NoWrap"
               Foreground="#CC000000" Opacity="0.8"
               Typography.NumeralAlignment="Tabular"
               AutomationProperties.AccessibilityView="Raw" />
    <TextBlock x:Name="ProgressText" Margin="8,0,8,0" VerticalAlignment="Center"
               Text="{x:Bind Text, Mode=OneWay}" TextWrapping="NoWrap"
               Foreground="{ThemeResource ProgressTextBrush}"
               Typography.NumeralAlignment="Tabular" />
  </Grid>
</UserControl>
