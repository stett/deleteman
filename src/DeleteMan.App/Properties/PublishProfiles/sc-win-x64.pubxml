<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish: Native AOT executable with the Windows App Runtime files beside it. No runtime needs to be
  installed on the target machine. This is the portable zip (scripts\release.ps1).
  dotnet publish src\DeleteMan.App -c Release -p:PublishProfile=sc-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish\sc-win-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- A self-contained app must never look for an installed runtime at start-up. -->
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>false</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
  </PropertyGroup>
</Project>
