<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared control styles: the compact icon buttons of the rows, the red "danger" button used for Cancel and for
  destructive dialog buttons, and text styles for the dialogs. Styles use {ThemeResource} in their setters so
  they follow the element's theme (including a RequestedTheme override), which code-side lookups would not.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeleteMan.App.Controls">

  <!-- ===== IconButton: 28×26 row control with a 5 px radius (the web UI's .ctl) ===== -->
  <Style x:Key="IconButtonStyle" TargetType="local:IconButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:IconButton">
          <Grid x:Name="RootGrid"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <!-- Coloured hover wash for recycle/delete; it covers the border too (negative margin). -->
            <Border x:Name="HoverFill" Margin="-1" Opacity="0"
                    Background="{TemplateBinding HoverBackground}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <FontIcon x:Name="Icon"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="{TemplateBinding Glyph}"
                      FontSize="{TemplateBinding GlyphSize}"
                      Foreground="{TemplateBinding Foreground}" />
            <FontIcon x:Name="HoverIcon" Opacity="0"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="{TemplateBinding Glyph}"
                      FontSize="{TemplateBinding GlyphSize}" />
            <!-- Drawn icons (IconButton.Shape): shown instead of the glyphs; Data, and the hover copy's Stroke,
                 are set in code. -->
            <Path x:Name="IconShape" Visibility="Collapsed"
                  Width="12" Height="12" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <Path x:Name="HoverIconShape" Opacity="0" Visibility="Collapsed"
                  Width="12" Height="12" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Setter Target="HoverFill.Opacity" Value="1" />
                    <Setter Target="Icon.Opacity" Value="0" />
                    <Setter Target="HoverIcon.Opacity" Value="1" />
                    <Setter Target="IconShape.Opacity" Value="0" />
                    <Setter Target="HoverIconShape.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                    <Setter Target="HoverFill.Opacity" Value="0.8" />
                    <Setter Target="Icon.Opacity" Value="0" />
                    <Setter Target="HoverIcon.Opacity" Value="0.85" />
                    <Setter Target="IconShape.Opacity" Value="0" />
                    <Setter Target="HoverIconShape.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 22×22 variant for the job dismiss button. -->
  <!-- The implicit style: every IconButton gets the template above unless it picks a keyed variant. -->
  <Style TargetType="local:IconButton" BasedOn="{StaticResource IconButtonStyle}" />

  <Style x:Key="MiniIconButtonStyle" TargetType="local:IconButton" BasedOn="{StaticResource IconButtonStyle}">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="GlyphSize" Value="11" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FocusVisualMargin" Value="-2" />
  </Style>

  <!-- The row pin while it is in charge: filled with the accent colour, like a checked toggle. -->
  <Style x:Key="PinnedIconButtonStyle" TargetType="local:IconButton" BasedOn="{StaticResource IconButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="HoverBackground" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
    <Setter Property="HoverForeground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>

  <!-- ===== Red button: Cancel for running deletions, destructive dialog buttons ===== -->
  <Style x:Key="DangerButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource DangerBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource DangerForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource DangerPressedBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,5,11,6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource DangerHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Background" Value="{ThemeResource DangerPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Compact variant for buttons inside a 26 px row (Cancel in the controls cell, the jobs banner). -->
  <Style x:Key="SmallDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
    <Setter Property="Padding" Value="10,0,10,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Padding" Value="10,0,10,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ===== Shell: one rounded card per drive ===== -->
  <Style x:Key="DriveCardStyle" TargetType="Border">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  </Style>

  <!-- Italic muted text in an empty bar ("loading…", "empty folder"). -->
  <Style x:Key="BarPlaceholderTextStyle" TargetType="TextBlock">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="ToolTipTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="ToolTipLineTextStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- ===== Text styles (used by RowControl, JobLine and the dialogs) ===== -->
  <Style x:Key="MonoTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="13" />
    <!-- Explicit: inside a ContentDialog the inherited weight would otherwise make paths look bold. -->
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <!-- A path shown in a dialog: selectable, wraps anywhere (long paths have no spaces). -->
  <Style x:Key="DialogPathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="CodeBlockBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <Style x:Key="DialogBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="DialogNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="CriticalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>

  <Style x:Key="CriticalStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CriticalTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
