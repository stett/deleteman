<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine: volume enumeration, breadth-first scanning, parallel NT-level deletion, the job journal and the
    filesystem watcher. No UI framework dependency, so it can be unit-tested and benchmarked on its own.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DeleteMan.Engine</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050;IL2075;CA2014</WarningsAsErrors>
  </PropertyGroup>

  <!-- Internals are visible to the test project and the benchmark. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DeleteMan.Engine.Tests" />
    <InternalsVisibleTo Include="DeleteMan.Bench" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generates [LibraryImport]-based, AOT-safe bindings for the names listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
