<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI automation smoke tests against the real deleteman.exe (FlaUI / UIA3). Every test is [Fact(Explicit = true)]:
    they need a desktop session and a built app, so `dotnet test` on the solution skips them. Run them with the
    test runner's explicit filter (see the test project's SmokeTests.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DeleteMan.UITests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FlaUI.Core" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
