<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure view-model and formatting tests; no WinUI dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DeleteMan.ViewModels.Tests</RootNamespace>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (opted in via the "test" section of global.json). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeleteMan.ViewModels\DeleteMan.ViewModels.csproj" />
  </ItemGroup>

</Project>
